FIREBASE_ADMIN_PROJECT_ID=
# Trigger.dev dev key (tr_dev_... for development)
TRIGGER_SECRET_KEY=
CRON_SECRET=
ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
